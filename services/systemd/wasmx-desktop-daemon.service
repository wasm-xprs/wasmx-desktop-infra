[Unit]
Description=wasm-xprs desktop Wasmtime daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/wasmx-desktop-daemon
Environment=WASMX_DESKTOP_ADDR=127.0.0.1:8765
Environment=WASMX_MAX_MEMORY_BYTES=134217728
Environment=WASMX_MAX_PARALLEL_INVOCATIONS=8
Environment=WASMX_DEFAULT_FUEL=50000000
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6
TasksMax=128
LimitNOFILE=4096
ReadWritePaths=%h/.wasm-xprs

[Install]
WantedBy=default.target
